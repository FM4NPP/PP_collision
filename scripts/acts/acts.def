# ACTS reference container, Singularity recipe: the same image as the Dockerfile next to it, for building
# without docker rights (singularity build --fakeroot). Run from scripts/acts; see README.md.
Bootstrap: docker
From: ubuntu:24.04

%files
    acts-python /usr/local/bin/acts-python

%post
    # ACTS release tag and parallel compile jobs: keep in step with the Dockerfile's ARGs
    ACTS_VERSION=v48.2.0
    JOBS=${JOBS:-8}

    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git ca-certificates \
        python3 python3-dev python3-numpy \
        libboost-dev libboost-filesystem-dev libboost-program-options-dev libboost-test-dev \
        libeigen3-dev
    rm -rf /var/lib/apt/lists/*

    # build tree kept: its python/setup.sh is how ACTS documents making the bindings importable
    git clone --depth 1 --branch ${ACTS_VERSION} https://github.com/acts-project/acts.git /opt/acts-src
    cmake -S /opt/acts-src -B /opt/acts-build -DCMAKE_BUILD_TYPE=Release -DACTS_BUILD_PYTHON_BINDINGS=ON
    cmake --build /opt/acts-build -j ${JOBS}

    # not fatal: a launcher problem must not throw away the compile (README: run without the launcher)
    chmod 755 /usr/local/bin/acts-python
    acts-python -c "import acts; print('acts OK:', acts.__file__)" || echo "WARNING: acts import check failed"
