# ACTS base image, Singularity recipe (build_images.sh builds it, then the module inside it): ROOT (from source, C++20),
# HepMC3 (with ROOT I/O) and ACTS v48.2.0 with its Python bindings, examples, ROOT/TGeo and JSON plugins, all
# in C++20 and with one nlohmann::json. Unmodified ACTS (MPL-2.0), installed as an external library. Slow (ROOT
# and ACTS both compile, an hour or more); rebuilt only to change versions.
Bootstrap: docker
From: ubuntu:24.04

%files
    acts-python /usr/local/bin/acts-python

%post
    ACTS_VERSION=v48.2.0
    ROOT_VERSION=v6-32-08
    HEPMC3_VERSION=3.2.7
    CXX_STANDARD=20
    JOBS=${JOBS:-8}

    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git ca-certificates wget \
        python3 python3-dev python3-numpy \
        libboost-dev libboost-filesystem-dev libboost-program-options-dev libboost-test-dev \
        libeigen3-dev libtbb-dev zlib1g-dev liblzma-dev liblz4-dev libzstd-dev libxxhash-dev libssl-dev \
        libpcre3-dev libgsl-dev nlohmann-json3-dev
    rm -rf /var/lib/apt/lists/*

    # ROOT: only what ACTS uses (Core, RIO, Tree, Hist, Geom, Graf, GenVector, TreePlayer), no graphics, and the
    # system nlohmann::json (the one ACTS uses below; two copies break the ACTS examples' JSON symbols)
    git clone --depth 1 --branch ${ROOT_VERSION} https://github.com/root-project/root.git /opt/root-src
    cmake -S /opt/root-src -B /opt/root-build -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_STANDARD=${CXX_STANDARD} \
        -DCMAKE_INSTALL_PREFIX=/opt/root \
        -Dx11=OFF -Dopengl=OFF -Dwebgui=OFF -Droot7=OFF -Dtmva=OFF -Droofit=OFF -Dpyroot=OFF -Dxrootd=OFF \
        -Dbuiltin_xrootd=OFF -Dfftw3=OFF -Dmathmore=OFF -Dmysql=OFF -Dpgsql=OFF -Dsqlite=OFF -Ddavix=OFF \
        -Dssl=OFF -Dhttp=OFF -Dspectrum=OFF -Dunuran=OFF -Dimt=ON -Dbuiltin_tbb=OFF -Dbuiltin_nlohmannjson=OFF \
        -Dtesting=OFF -Dfail-on-missing=OFF
    cmake --build /opt/root-build -j ${JOBS} --target install
    rm -rf /opt/root-src /opt/root-build
    export LD_LIBRARY_PATH=/opt/root/lib:/opt/hepmc3/lib:/opt/hepmc3/lib64:$LD_LIBRARY_PATH

    # HepMC3 with rootIO (the ACTS examples need it), against the ROOT above, no Python
    git clone --depth 1 --branch ${HEPMC3_VERSION} https://gitlab.cern.ch/hepmc/HepMC3.git /opt/hepmc3-src
    cmake -S /opt/hepmc3-src -B /opt/hepmc3-build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/hepmc3 \
        -DCMAKE_PREFIX_PATH=/opt/root -DCMAKE_CXX_STANDARD=${CXX_STANDARD} -DHEPMC3_CXX_STANDARD=${CXX_STANDARD} \
        -DHEPMC3_ENABLE_ROOTIO=ON -DHEPMC3_ENABLE_PYTHON=OFF -DHEPMC3_BUILD_EXAMPLES=OFF -DHEPMC3_ENABLE_TEST=OFF
    cmake --build /opt/hepmc3-build -j ${JOBS} --target install
    rm -rf /opt/hepmc3-src /opt/hepmc3-build

    # ACTS: Python bindings + examples with ROOT (TGeoDetector, ROOT and JSON plugins), C++20 (ACTS defaults to
    # C++23; ROOT's headers need their own standard), the system nlohmann::json. The build tree is kept for
    # python/setup.sh; the install (/opt/acts) is what the module compiles against.
    git clone --depth 1 --branch ${ACTS_VERSION} https://github.com/acts-project/acts.git /opt/acts-src
    cmake -S /opt/acts-src -B /opt/acts-build -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_STANDARD=${CXX_STANDARD} \
        -DCMAKE_PREFIX_PATH="/opt/root;/opt/hepmc3" -DACTS_USE_SYSTEM_NLOHMANN_JSON=ON \
        -DACTS_BUILD_PYTHON_BINDINGS=ON -DACTS_BUILD_EXAMPLES=ON -DACTS_BUILD_EXAMPLES_ROOT=ON \
        -DACTS_BUILD_PLUGIN_ROOT=ON -DACTS_BUILD_PLUGIN_JSON=ON
    # on failure, rerun serially so the first error is the last thing printed
    cmake --build /opt/acts-build -j ${JOBS} || cmake --build /opt/acts-build -j 1
    cmake --install /opt/acts-build --prefix /opt/acts > /dev/null

    # not fatal: a launcher problem must not throw away the compile (README: run without the launcher)
    chmod 755 /usr/local/bin/acts-python
    acts-python -c "import acts, acts.examples; print('acts OK:', acts.__file__)" || echo "WARNING: acts import check failed"

%environment
    # ROOT_INCLUDE_PATH: HepMC3's ROOT dictionaries find their headers (else harmless cling autoload errors)
    export ROOT_INCLUDE_PATH=/opt/hepmc3/include:$ROOT_INCLUDE_PATH
    export PATH=/opt/root/bin:$PATH
    export LD_LIBRARY_PATH=/opt/root/lib:/opt/hepmc3/lib:/opt/hepmc3/lib64:$LD_LIBRARY_PATH
    export ROOTSYS=/opt/root
