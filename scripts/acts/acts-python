#!/bin/sh
# python3 with the ACTS bindings importable; works under docker run and singularity exec alike
# (singularity ignores ENTRYPOINT, so the environment is set here, not in the image).
for setup in /opt/acts-build/python/setup.sh /opt/acts-build/this_acts.sh /opt/acts-build/this_acts_withdeps.sh; do
    if [ -f "$setup" ]; then
        . "$setup"
        break
    fi
done
exec python3 "$@"
