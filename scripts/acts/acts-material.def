# ACTS material container, Singularity recipe: ACTS v48.2.0 with its Python bindings AND its examples, ROOT/TGeo
# and JSON plugins, for building sPHENIX's tracking geometry from TGeo (TGeoDetector) and applying its JSON
# material map. Separate from acts.def, whose image (bindings only) stays as it is. Builds on the base image
# (ROOT and HepMC3, acts-material-base.def), so a failure here does not recompile ROOT. From scripts/acts, see
# README.md:
#   JOBS=8 singularity build --fakeroot acts-material-base.sif acts-material-base.def   (once)
#   JOBS=8 singularity build --fakeroot acts-material-48.2.0.sif acts-material.def
Bootstrap: localimage
From: acts-material-base.sif

%files
    acts-python /usr/local/bin/acts-python

%post
    ACTS_VERSION=v48.2.0
    JOBS=${JOBS:-8}
    export LD_LIBRARY_PATH=/opt/root/lib:/opt/hepmc3/lib:/opt/hepmc3/lib64:$LD_LIBRARY_PATH

    # One nlohmann::json for all of ACTS. A base image built before acts-material-base.def switched ROOT to the
    # system copy has ROOT's own older copy in its include directory; ACTS targets that also see ROOT's headers
    # then compile against it while the JSON plugin uses another, and the examples fail to load (undefined
    # Acts::from_json). Use the system one everywhere and hide any copy under ROOT.
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends nlohmann-json3-dev
    rm -rf /var/lib/apt/lists/*
    echo "nlohmann json copies under /opt/root (removed):"; find /opt/root/include -path '*nlohmann*' -print
    find /opt/root/include -depth -path '*nlohmann*' -exec rm -rf {} +

    # ACTS: Python bindings + examples with ROOT (TGeoDetector, ROOT and JSON plugins). C++20, the standard ROOT
    # was built in: ACTS defaults to C++23, and ROOT's headers do not support a different standard than their own.
    # Build tree kept, as in acts.def, for python/setup.sh
    git clone --depth 1 --branch ${ACTS_VERSION} https://github.com/acts-project/acts.git /opt/acts-src
    cmake -S /opt/acts-src -B /opt/acts-build -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_STANDARD=20 \
        -DCMAKE_PREFIX_PATH="/opt/root;/opt/hepmc3" \
        -DACTS_BUILD_PYTHON_BINDINGS=ON -DACTS_BUILD_EXAMPLES=ON -DACTS_BUILD_EXAMPLES_ROOT=ON \
        -DACTS_BUILD_PLUGIN_ROOT=ON -DACTS_BUILD_PLUGIN_JSON=ON -DACTS_USE_SYSTEM_NLOHMANN_JSON=ON
    # on failure, rerun serially so the first error is the last thing printed
    cmake --build /opt/acts-build -j ${JOBS} || cmake --build /opt/acts-build -j 1

    # not fatal: a launcher problem must not throw away the compile (README: run without the launcher)
    chmod 755 /usr/local/bin/acts-python
    acts-python -c "import acts, acts.examples; print('acts OK:', acts.__file__)" || echo "WARNING: acts import check failed"

%environment
    export PATH=/opt/root/bin:$PATH
    export LD_LIBRARY_PATH=/opt/root/lib:/opt/hepmc3/lib:/opt/hepmc3/lib64:$LD_LIBRARY_PATH
    export ROOTSYS=/opt/root
